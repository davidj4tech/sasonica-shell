// Sasonica Shell — wrangler config. install.mjs fills in the two ids and writes
// wrangler.jsonc next to this file; do not edit the template by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__WORKER_NAME__",
  "main": "src/index.ts",
  "account_id": "__ACCOUNT_ID__",
  "compatibility_date": "2026-07-01",
  // OAuth (src/oauth.ts) fetches Client ID Metadata Documents from URLs a
  // client names: this keeps those fetches off private addresses.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Invocation logs are off because they record each request's URL, and the
  // MCP path IS the credential: with them on, every connector secret sat in
  // Workers Logs for seven days. The Worker's own console lines stay on, and
  // none of them prints a secret. tests/check-install.mjs holds this.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // install.mjs puts the OAuth KV binding here when SASONICA_OWNER_EMAIL is set.
  // __OAUTH_KV__
  "d1_databases": [
    { "binding": "DB", "database_name": "__DB_NAME__", "database_id": "__DB_ID__" }
  ],
  "vars": { "SASONICA_WAIT_DEFAULT": "30", "SASONICA_WAIT_MAX": "30" }
}
